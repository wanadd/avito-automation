APP_ENV=production
DOMAIN=avito.planam.ru
APP_BASE_URL=https://avito.planam.ru

POSTGRES_DB=avito_automation
POSTGRES_USER=avito
POSTGRES_PASSWORD=<generate-strong-random-password>
DATABASE_URL=postgresql+asyncpg://avito:<same-password>@postgres:5432/avito_automation

REDIS_URL=redis://redis:6379/0

SESSION_SECRET=<generate-at-least-32-random-bytes>
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
ALLOWED_HOSTS=avito.planam.ru,127.0.0.1,localhost,api,avito-automation-api
CORS_ORIGINS=https://avito.planam.ru

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_COLLECTOR_ENABLED=false
TELEGRAM_OPERATOR_IDS=
TELEGRAM_PRICES_BOT_ENABLED=false
TELEGRAM_API_BASE_URL=https://tg-relay.planam.ru
TELEGRAM_PRICES_ALLOWED_USER_IDS=
TELEGRAM_PRICES_POLL_TIMEOUT_SECONDS=30
TELEGRAM_PRICE_BATCH_WINDOW_SECONDS=30
# Put TELEGRAM_PRICES_BOT_TOKEN in .env.telegram-prices on the host. Do not commit it.

AUTO_PREPARE_PUBLICATION=false
PUBLICATION_MAX_ATTEMPTS=1
PUBLICATION_RETRY_BASE_SECONDS=60

COMPOSE_PROJECT_NAME=avito_automation_prod
