APP_ENV=production
APP_BASE_URL=https://CHANGE_ME_DOMAIN
DOMAIN=CHANGE_ME_DOMAIN

POSTGRES_DB=avito_automation
POSTGRES_USER=avito
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://avito:CHANGE_ME@postgres:5432/avito_automation

